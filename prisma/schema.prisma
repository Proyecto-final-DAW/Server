/**
 * This file defines the desired database schema.
 * It is used only to generate migrations automatically with migra.
 * Runtime queries use `pg`; TypeScript imports enums/types from `@prisma/client` after `prisma generate`.
 */

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Sex {
  MALE
  FEMALE
  NON_BINARY
}

enum Goal {
  LOSE_FAT
  GAIN_MUSCLE
  MAINTAIN
  HEALTH
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  FULL_GYM
  HOME_WEIGHTS
  BODYWEIGHT
}

enum Injury {
  NONE
  KNEE
  BACK
  SHOULDER
  OTHER
}

enum ExerciseType {
  strength
  cardio
  explosive
  stretch
}

enum CardioIntensity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                   Int              @id @default(autoincrement())
  name                 String           @db.VarChar(255)
  email                String           @unique @db.VarChar(320)
  hashed_password      String           @db.Text
  tokens               String[]         @default([])
  age                  Int?
  birth_date           DateTime?        @db.Date
  sex                  Sex?
  weight               Decimal?         @db.Decimal(4, 1)
  height               Decimal?         @db.Decimal(4, 1)
  activity_level       String?          @db.VarChar(100)
  goals                Goal[]           @default([])
  experience_level     ExperienceLevel?
  equipment            Equipment[]      @default([])
  days_per_week        String?          @db.VarChar(10)
  injuries             Injury[]         @default([])
  injury_notes         String?          @db.VarChar(500)
  sleep_hours          Int?
  daily_calories       Int?
  protein_grams        Int?
  fat_grams            Int?
  carb_grams           Int?
  onboarding_completed Boolean          @default(false)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @default(now()) @updatedAt

  stats           Stats?
  sessions        Session[]
  routines        Routine[]
  user_milestones UserMilestone[]
  weight_logs     WeightLog[]
  class_state     UserClassState?
  audit_as_actor  AuditLog[]      @relation("audit_actor")
  audit_as_target AuditLog[]      @relation("audit_target")

  @@map("users")
}

model WeightLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  weight     Decimal  @db.Decimal(5, 2)
  date       DateTime @db.Date
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
  @@map("weight_logs")
}

model Stats {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  strength          Int       @default(0)
  endurance         Int       @default(0)
  stamina           Int       @default(0)
  agility           Int       @default(0)
  tenacity          Int       @default(0)
  vigor             Int       @default(0)
  strength_level    Int       @default(1)
  endurance_level   Int       @default(1)
  stamina_level     Int       @default(1)
  agility_level     Int       @default(1)
  tenacity_level    Int       @default(1)
  vigor_level       Int       @default(1)
  streak                       Int       @default(0)
  best_streak                  Int       @default(0)
  last_session_date            DateTime? @db.Date
  last_qualifying_week_monday  DateTime? @db.Date
  diet_streak                  Int       @default(0)
  best_diet_streak             Int       @default(0)
  last_diet_date               DateTime? @db.Date
  updated_at                   DateTime  @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("stats")
}

model Session {
  id         Int      @id @default(autoincrement())
  user_id    Int
  routine_id Int?
  date       DateTime @db.Date
  created_at DateTime @default(now())

  user      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routine   Routine?          @relation(fields: [routine_id], references: [id], onDelete: SetNull)
  exercises SessionExercise[]

  // One session per day per user — enforced at the DB level so the
  // race between the application's pre-check SELECT and the INSERT can
  // never double-insert. See migration 20260515120000_sessions_unique_user_date.
  @@unique([user_id, date], map: "sessions_user_id_date_key")
  @@map("sessions")
}

model SessionExercise {
  id               Int              @id @default(autoincrement())
  session_id       Int
  exercise_api_id  String           @db.VarChar(50)
  name             String           @db.VarChar(200)
  type             ExerciseType
  order_index      Int
  // Cardio metadata — populated only when the entry comes from the
  // post-workout cardio log (bike, HIIT, treadmill…). Strength rows
  // keep these as NULL and continue to live off the `sets` relation.
  duration_minutes Int?
  intensity        CardioIntensity?
  distance_km      Decimal?         @db.Decimal(5, 2)

  session Session       @relation(fields: [session_id], references: [id], onDelete: Cascade)
  sets    ExerciseSet[]

  @@index([session_id])
  @@map("session_exercises")
}

model ExerciseSet {
  id                  Int     @id @default(autoincrement())
  session_exercise_id Int
  reps                Int
  weight              Decimal @db.Decimal(6, 2)
  duration_seconds    Int?
  order_index         Int

  session_exercise SessionExercise @relation(fields: [session_exercise_id], references: [id], onDelete: Cascade)

  @@index([session_exercise_id])
  @@map("exercise_sets")
}

model Routine {
  id          Int      @id @default(autoincrement())
  user_id     Int
  name        String   @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  user      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  sessions  Session[]

  @@map("routines")
}

model RoutineExercise {
  id              Int     @id @default(autoincrement())
  routine_id      Int
  exercise_api_id String  @db.VarChar(50)
  exercise_name   String? @db.VarChar(200)
  sets            Int?
  reps            Int?
  order_index     Int?

  routine Routine @relation(fields: [routine_id], references: [id], onDelete: Cascade)

  @@map("routine_exercises")
}

enum ConditionType {
  STAT_LEVEL
  STREAK
  TOTAL_SESSIONS
  TOTAL_WEIGHT
}

model Milestone {
  id              Int           @id @default(autoincrement())
  // UNIQUE on `name` so seed migrations stay idempotent — a re-run
  // of `seed_milestones` would otherwise duplicate every row and the
  // next session save would fire the same unlock multiple times.
  // See migration 20260516120000_milestones_unique_name.
  name            String        @unique(map: "milestones_name_key") @db.VarChar(100)
  description     String        @db.Text
  condition_type  ConditionType
  condition_value Int
  icon            String        @db.VarChar(50)

  user_milestones UserMilestone[]

  @@map("milestones")
}

model UserMilestone {
  id           Int      @id @default(autoincrement())
  user_id      Int
  milestone_id Int
  unlocked_at  DateTime @default(now())

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestone_id], references: [id], onDelete: Cascade)

  @@unique([user_id, milestone_id])
  @@map("user_milestones")
}

enum ClassTierStage {
  NORMAL
  TRANSCENDENT
}

model UserClassState {
  user_id                 Int             @id
  current_tier            Int             @default(0) @db.SmallInt
  vocation_class_id       String?         @db.VarChar(50)
  specialization_class_id String?         @db.VarChar(50)
  legendary_class_id      String?         @db.VarChar(50)
  legendary_stage         ClassTierStage?
  is_maestro_supremo      Boolean         @default(false)
  is_leyenda              Boolean         @default(false)
  pending_choice_tier     Int?            @db.SmallInt
  created_at              DateTime        @default(now())
  updated_at              DateTime        @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([pending_choice_tier])
  @@map("user_class_state")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  action         String   @db.Text
  actor_user_id  Int?
  target_user_id Int?
  request_id     String?
  ip             String?
  user_agent     String?
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())

  actor_user  User? @relation("audit_actor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  target_user User? @relation("audit_target", fields: [target_user_id], references: [id], onDelete: SetNull)

  @@index([action, created_at(sort: Desc)])
  @@index([actor_user_id, created_at(sort: Desc)])
  @@index([target_user_id, created_at(sort: Desc)])
  @@index([request_id])
  @@map("audit_logs")
}
