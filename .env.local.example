# =============================================================================
# Required
# =============================================================================
PORT=3000
DATABASE_URL=postgresql://gymuser:gympass@localhost:5432/gymapp?sslmode=disable
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
JWT_SECRET=
JWT_EXPIRES_IN=7d

# =============================================================================
# Optional — uncomment and tune if you need to override the defaults
# =============================================================================

# Local-dev auth bypass. ONLY honoured when NODE_ENV=development AND the
# flag is exactly "1". Boots refuses if either condition fails. The
# numeric LOCAL_DEV_USER_ID must be a positive integer matching a
# seeded user — the request `req.user.id` resolves to it without any
# token. Useful for poking at protected routes from curl / Postman in
# dev. Never set in any non-dev environment.
# LOCAL_DEV_AUTH_BYPASS=0
# LOCAL_DEV_USER_ID=1

# Trust-proxy toggle. Netlify / Vercel / Heroku / k8s ingress all add
# `X-Forwarded-For`. Without `app.set('trust proxy', N)` Express returns
# the proxy IP via `req.ip`, which breaks every per-IP rate limiter.
# Set to "1" (single hop, the common case) or a number of trusted hops.
# `loopback,linklocal,uniquelocal` is the explicit local-dev variant.
# TRUST_PROXY=1

# JSON body size cap. Default 100kb is plenty for the largest legit
# payloads (routine creation with ~50 exercises).
# REQUEST_BODY_LIMIT=100kb
# URLENCODED_BODY_LIMIT=25kb

# Graceful-shutdown grace window after SIGTERM. The server tries to
# drain in-flight requests + the pg pool; this is the absolute deadline
# before it force-exits. Should be < the orchestrator's SIGKILL window.
# SHUTDOWN_TIMEOUT_MS=15000

# Postgres pool sizing.
# PG_POOL_MAX=5                # Max concurrent connections per process.
# PG_POOL_IDLE_MS=30000        # Close idle conns after this many ms.
# PG_POOL_CONNECTION_MS=5000   # Fail-fast threshold for getting a conn.
# PG_STATEMENT_TIMEOUT_MS=10000 # Cap any single query at this many ms.

# Global rate limit (every authenticated/anonymous request).
# GLOBAL_RATE_WINDOW_MS=60000  # 1 minute
# GLOBAL_RATE_MAX_PER_IP=120

# Auth-flow rate limits. Login + register are double-keyed (per-IP and
# per-email) to throttle credential stuffing without locking out
# legitimate users sharing a NAT. Change-password is keyed on the
# authenticated userId so a coordinated multi-IP attack still shares
# one quota.
# AUTH_LOGIN_WINDOW_MS=900000      # 15 minutes
# AUTH_LOGIN_MAX_PER_IP=30
# AUTH_LOGIN_MAX_PER_EMAIL=10
# AUTH_REGISTER_WINDOW_MS=900000
# AUTH_REGISTER_MAX_PER_IP=10
# AUTH_REGISTER_MAX_PER_EMAIL=5
# AUTH_CHANGE_PASSWORD_WINDOW_MS=900000
# AUTH_CHANGE_PASSWORD_MAX=5
