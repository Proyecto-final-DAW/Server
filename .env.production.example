# Producción. En Render estas variables se configuran en el dashboard
# (Settings -> Environment); este fichero es solo de referencia.
# Render inyecta PORT automáticamente, no hace falta definirlo allí.
PORT=3000
# Cadena de conexión de Neon (incluye sslmode=require).
DATABASE_URL=
# Origen del front en Vercel.
CORS_ORIGIN=https://your-frontend.example.com

# 32+ characters, generate with `openssl rand -hex 32`. The boot
# guard refuses to start if it's shorter.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# =============================================================================
# Strongly recommended in production
# =============================================================================

# Behind a proxy (Render, Vercel, ALB, k8s ingress, Cloudflare). The
# rate limiters key on req.ip, which is the proxy's IP if this is left
# at the default — meaning every authenticated request from any user
# shares the same rate-limit quota. "1" trusts a single hop (the
# typical case).
TRUST_PROXY=1

# =============================================================================
# Optional knobs — uncomment to override defaults
# =============================================================================

# REQUEST_BODY_LIMIT=100kb
# URLENCODED_BODY_LIMIT=25kb
# SHUTDOWN_TIMEOUT_MS=15000
# PG_POOL_MAX=5
# PG_POOL_IDLE_MS=30000
# PG_POOL_CONNECTION_MS=5000
# PG_STATEMENT_TIMEOUT_MS=10000
# GLOBAL_RATE_WINDOW_MS=60000
# GLOBAL_RATE_MAX_PER_IP=120
# AUTH_LOGIN_WINDOW_MS=900000
# AUTH_LOGIN_MAX_PER_IP=30
# AUTH_LOGIN_MAX_PER_EMAIL=10
# AUTH_REGISTER_WINDOW_MS=900000
# AUTH_REGISTER_MAX_PER_IP=10
# AUTH_REGISTER_MAX_PER_EMAIL=5
# AUTH_CHANGE_PASSWORD_WINDOW_MS=900000
# AUTH_CHANGE_PASSWORD_MAX=5
