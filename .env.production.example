# Producción. En Render estas variables se configuran en el dashboard
# (Settings -> Environment); este fichero es solo de referencia.
# Render inyecta PORT automáticamente, no hace falta definirlo allí.
PORT=3000
# Cadena de conexión de Neon (incluye sslmode=require).
DATABASE_URL=
# Origen del front en Vercel.
CORS_ORIGIN=https://your-frontend.example.com
JWT_SECRET=
JWT_EXPIRES_IN=7d
